[Unit]
Description=Knowledge Graph Learning Studio
After=network.target

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/home/ubuntu/apps/fixing_repo/new/knowledge_graph
ExecStart=/home/ubuntu/apps/fixing_repo/new/knowledge_graph/.venv/bin/streamlit run app_streamlit.py --server.address 0.0.0.0 --server.port 8503 --server.headless true
Restart=always
RestartSec=5
Environment=PYTHONUNBUFFERED=1

[Install]
WantedBy=multi-user.target
